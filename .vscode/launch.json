{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch",
            "program": "${workspaceRoot}/target/debug/delegua-compilador",
            "args": ["construa", "${workspaceRoot}/exemplos/delegua/escreva.delegua"],
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal",
            "env": [
                "PATH=/opt/homebrew/opt/llvm/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            ]
        }
    ]
}