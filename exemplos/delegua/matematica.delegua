importar { absoluto, potencia, raiz_quadrada } de "matematica";

escreva("Testando funções matemáticas:")
escreva("Absoluto de -5: " + texto(absoluto(-5)))
escreva("Potência de 2^3: " + texto(2 ** 3))
escreva("Potência de 5^4: " + texto(potencia(5, 4)))
escreva("Raiz quadrada de 16: " + texto(raiz_quadrada(16)))
escreva("Raiz quadrada de 25: " + texto(raiz_quadrada(25)))
