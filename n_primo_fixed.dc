funcao ehPrimo(n) {
    se n < 2 {
        retorna falso;
    }
    se n == 2 {
        retorna verdadeiro;
    }
    se n % 2 == 0 {
        retorna falso;
    }
    
    var limite = n / 2;
    para (var i = 3; i <= limite; i++) {
        se n % i == 0 {
            retorna falso;
        }
    }
    retorna verdadeiro;
}

funcao contarPrimos(limite) {
    var contador = 0;
    para (var numero = 2; numero <= limite; numero++) {
        se (ehPrimo(numero)) {
            contador++;
        }
    }
    retorna contador;
}

var limite = 1000000;
var resultado = contarPrimos(limite);
escreva("RESULT:" + texto(resultado));