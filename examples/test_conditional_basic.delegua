// Test basic conditional statements
var x = 10;
var y = 5;

se (x > y) {
    escreva("x é maior que y");
}

se (x < y) {
    escreva("x é menor que y");
} senao {
    escreva("x não é menor que y");
}

// Test with variables and expressions
var resultado = x + y;
se (resultado > 10) {
    escreva("Resultado é maior que 10: ");
    escreva(resultado);
} senao {
    escreva("Resultado é menor ou igual a 10");
}