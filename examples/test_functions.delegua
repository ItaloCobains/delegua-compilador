// Test user-defined functions
funcao somar(a, b) {
    retorna a + b;
}

funcao saudacao(nome) {
    escreva("Olá, ");
    escreva(nome);
    escreva("!");
}

// Test function calls
var resultado = somar(10, 5);
escreva("Resultado da soma: ");
escreva(resultado);

saudacao("Maria");

// Test function with conditional
funcao maiorQue(x, y) {
    se (x > y) {
        retorna x;
    } senao {
        retorna y;
    }
}

var maior = maiorQue(8, 12);
escreva("Maior numero: ");
escreva(maior);