// Programa Delegua complexo demonstrando funcionalidades principais
escreva("=== PROGRAMA DELEGUA COMPLETO ===");

// 1. Declaração de variáveis e operações básicas
var numero = 42;
var nome = "Delegua";
var negativo = -15;

escreva("--- VARIÁVEIS BÁSICAS ---");
escreva("Número: ");
escreva(numero);
escreva("Nome: ");
escreva(nome);

// 2. Operações aritméticas
escreva("--- OPERAÇÕES ARITMÉTICAS ---");
var soma = numero + 58;
var produto = numero * 2;
var potencia_result = numero ** 2;
var divisao = numero / 6;
var resto = numero % 5;

escreva("42 + 58 = ");
escreva(soma);
escreva("42 * 2 = ");
escreva(produto);
escreva("42 ** 2 = ");
escreva(potencia_result);
escreva("42 / 6 = ");
escreva(divisao);
escreva("42 % 5 = ");
escreva(resto);

// 3. Operadores de incremento/decremento
var contador = 10;
escreva("--- INCREMENTO/DECREMENTO ---");
escreva("Contador inicial: ");
escreva(contador);
contador++;
escreva("Após ++: ");
escreva(contador);
contador--;
escreva("Após --: ");
escreva(contador);

// 4. Funções de string
escreva("--- FUNÇÕES DE STRING ---");
var texto = "Hello World";
var tamanho = comprimento(texto);
var maiusculo = maiuscula(texto);
var minusculo = minuscula(texto);

escreva("Texto original: ");
escreva(texto);
escreva("Comprimento: ");
escreva(tamanho);
escreva("Maiúscula: ");
escreva(maiusculo);
escreva("Minúscula: ");
escreva(minusculo);

// 5. Funções matemáticas
escreva("--- FUNÇÕES MATEMÁTICAS ---");
var absoluto_val = absoluto(negativo);
var raiz = raiz_quadrada(144);
var pot = potencia(3, 4);

escreva("absoluto(-15) = ");
escreva(absoluto_val);
escreva("raiz_quadrada(144) = ");
escreva(raiz);
escreva("potencia(3, 4) = ");
escreva(pot);

// 6. Comparações e lógica booleana
escreva("--- COMPARAÇÕES ---");
var a = 10;
var b = 20;

se (a < b) {
    escreva("10 é menor que 20");
}

se (b > a) {
    escreva("20 é maior que 10");
}

// 7. Estruturas condicionais
escreva("--- CONDICIONAIS ---");
se (numero > 40) {
    escreva("Número é maior que 40");
} senao se (numero > 20) {
    escreva("Número é maior que 20");
} senao {
    escreva("Número é 20 ou menor");
}

// 8. Arrays simples
escreva("--- ARRAYS ---");
var numeros = [1, 2, 3, 4, 5];
var primeiro = numeros[0];
var ultimo = numeros[4];

escreva("Primeiro elemento: ");
escreva(primeiro);
escreva("Último elemento: ");
escreva(ultimo);

// 9. Operações complexas combinadas
escreva("--- OPERAÇÕES COMBINADAS ---");
var resultado_complexo = absoluto(potencia(-2, 3)) + raiz_quadrada(64);
escreva("absoluto(potencia(-2, 3)) + raiz_quadrada(64) = ");
escreva(resultado_complexo);

var texto_processado = maiuscula(minuscula("TeSte MiXtO"));
escreva("maiuscula(minuscula('TeSte MiXtO')) = ");
escreva(texto_processado);

// 10. Casos extremos e testes
escreva("--- CASOS ESPECIAIS ---");
var zero = 0;
var um = 1;
escreva("raiz_quadrada(0) = ");
escreva(raiz_quadrada(zero));
escreva("raiz_quadrada(1) = ");
escreva(raiz_quadrada(um));
escreva("potencia(2, 0) = ");
escreva(potencia(2, 0));
escreva("absoluto(0) = ");
escreva(absoluto(zero));

// 11. Teste de expressões aninhadas
var expressao_complexa = absoluto(-5) * potencia(2, 3) + comprimento("teste");
escreva("Expressão complexa: ");
escreva(expressao_complexa);

escreva("--- FIM DO PROGRAMA ---");